# ==============================================================================
# Stage 1 (Dev) Environment Variables Template
# Copy to .env and fill in secret values (TG_APP_ID, TG_APP_HASH, LLM_API_KEY).
# ==============================================================================

# --- PostgreSQL 16 ---
POSTGRES_DB=tg_agg_dev
POSTGRES_USER=tg_agg
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tg_agg:dev_password_change_me@localhost:5432/tg_agg_dev

# --- Redis 7 ---
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (v1.19+) ---
QDRANT_IMAGE=qdrant/qdrant:v1.19.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=localhost:6334
QDRANT_COLLECTION=public_channels_v1

# --- ingestion-go (MTProto Worker & Media Streamer) ---
TG_APP_ID=
TG_APP_HASH=
SOCKS5_PROXY_URL=
ALBUM_BUFFER_MS=1500
MEDIA_CACHE_TTL_HOURS=24

# --- ml-pipeline-py (Shared Embedding Backbone, Spam Cascade, Clustering, RAG) ---
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM_MRL=512
RERANKER_MODEL_ID=Qwen/Qwen3-Reranker-0.6B
COLDSTART_SPAM_MODEL_ID=deepvk/GeRaCl-USER2-base
COMMENT_RESCUE_MODEL_ID=deepvk/RuModernBERT-small
NLI_GATE_MODEL_ID=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7

CLUSTERING_TAU_LOW=0.72
CLUSTERING_TAU_HIGH=0.88
RERANK_MERGE_THRESHOLD=0.85
SW_SIMILARITY_THRESHOLD=0.85
NLI_ENTAILMENT_THRESHOLD=0.75

# --- External LLM API (Synthesis Layer) ---
LLM_API_KEY=
LLM_BASE_URL=
